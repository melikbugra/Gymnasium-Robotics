<?xml version="1.0" encoding="utf-8"?>
<mujoco>
	<compiler angle="radian" coordinate="local" meshdir="../stls/fetch" texturedir="../textures"></compiler>
	<option timestep="0.002">
		<flag warmstart="enable"></flag>
	</option>

	<!-- Improved collision detection settings -->
	<size nconmax="500" njmax="500"/>
	
	<default>
		<geom condim="4" friction="1 0.5 0.5" margin="0.001" solimp="0.99 0.99 0.01" solref="0.01 1"/>
	</default>

	<include file="shared.xml"></include>

	<worldbody>
		<geom name="floor0" pos="0.8 0.75 0" size="0.85 0.7 1" type="plane" condim="3" material="floor_mat"></geom>
		<body name="floor0" pos="0.8 0.75 0">
		</body>

		<include file="robot.xml"></include>

		<!-- Table -->
		<body pos="1.3 0.75 0.2" name="table0">
			<geom size="0.25 0.35 0.2" type="box" mass="2000" material="table_mat"></geom>
		</body>

		<!-- Box/Prism object - graspable by the robot -->
		<!-- Size: 0.025 x 0.025 x 0.06 (2.5cm x 2.5cm x 6cm) -->
		<body name="object0" pos="1.3 0.6 0.45">
			<joint name="object0:joint" type="free" damping="0.01"></joint>
			<geom name="object0" type="box" size="0.0125 0.0125 0.03" mass="0.5" rgba="0.2 0.6 0.85 1" condim="4" friction="1 0.5 0.5" margin="0.002" solimp="0.99 0.99 0.01" solref="0.01 1"></geom>
			<site name="object0" pos="0 0 0" size="0.0125 0.0125 0.03" rgba="0.2 0.6 0.85 0.3" type="box"></site>
		</body>

		<!-- Assembly Box with hole - fixed on table -->
		<!-- Box dimensions: inner size ~0.16m x 0.16m, wall thickness 0.02m, height 0.20m -->
		<!-- Thicker walls to prevent objects passing through -->
		<body name="assembly_box" pos="1.3 0.9 0.50">
			<!-- Bottom plate - thicker -->
			<geom name="box_bottom" type="box" size="0.10 0.10 0.01" pos="0 0 -0.09" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			
			<!-- Four walls - MUCH THICKER (0.02m = 2cm instead of 0.5cm) -->
			<!-- Front wall (positive Y) -->
			<geom name="box_wall_front" type="box" size="0.10 0.02 0.10" pos="0 0.08 0" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Back wall (negative Y) -->
			<geom name="box_wall_back" type="box" size="0.10 0.02 0.10" pos="0 -0.08 0" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Left wall (negative X) -->
			<geom name="box_wall_left" type="box" size="0.02 0.10 0.10" pos="-0.08 0 0" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Right wall (positive X) -->
			<geom name="box_wall_right" type="box" size="0.02 0.10 0.10" pos="0.08 0 0" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			
			<!-- Top plate with square hole in the center -->
			<!-- Hole size: ~0.04 x 0.04 (prism is 0.025x0.025, hole ~60% larger for easier insertion) -->
			<!-- Creating a frame around the hole using 4 boxes - THICKER -->
			<!-- Inner edge of hole at ±0.02 from center, so hole is 4cm x 4cm -->
			<!-- Top front piece: from y=0.02 to y=0.06 (edge of inner box) -->
			<geom name="box_top_front" type="box" size="0.06 0.02 0.01" pos="0 0.04 0.09" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Top back piece: from y=-0.02 to y=-0.06 -->
			<geom name="box_top_back" type="box" size="0.06 0.02 0.01" pos="0 -0.04 0.09" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Top left piece: from x=-0.02 to x=-0.06, only middle part -->
			<geom name="box_top_left" type="box" size="0.02 0.02 0.01" pos="-0.04 0 0.09" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			<!-- Top right piece: from x=0.02 to x=0.06, only middle part -->
			<geom name="box_top_right" type="box" size="0.02 0.02 0.01" pos="0.04 0 0.09" rgba="0.6 0.3 0.1 1" condim="4" friction="1 0.5 0.5" margin="0.002"></geom>
			
			<!-- Target site inside the box (at the bottom center) - this is the goal -->
			<site name="target0" pos="0 0 -0.08" size="0.02 0.02 0.02" rgba="1 0 0 1" type="sphere"></site>
		</body>

		<light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="false" pos="0 0 4" dir="0 0 -1" name="light0"></light>
	</worldbody>

	<actuator>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="30000" name="robot0:l_gripper_finger_joint" user="1"></position>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="30000" name="robot0:r_gripper_finger_joint" user="1"></position>
	</actuator>
</mujoco>
