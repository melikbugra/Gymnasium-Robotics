<?xml version="1.0" encoding="utf-8"?>
<mujoco>
	<compiler angle="radian" coordinate="local" meshdir="../stls/fetch" texturedir="../textures"></compiler>
	<option timestep="0.002">
		<flag warmstart="enable"></flag>
	</option>

	<include file="shared.xml"></include>

	<worldbody>
		<geom name="floor0" pos="0.8 0.75 0" size="0.85 0.7 1" type="plane" condim="3" material="floor_mat"></geom>
		<body name="floor0" pos="0.8 0.75 0">
			<site name="target0" pos="0 0 0.5" size="0.02 0.02 0.02" rgba="1 0 0 1" type="sphere"></site>
		</body>

		<include file="robot.xml"></include>

		<body pos="1.3 0.75 0.2" name="table0">
			<geom size="0.25 0.35 0.2" type="box" mass="2000" material="table_mat"></geom>
		</body>

		<!-- Square Peg object - 2cm × 2cm × 8cm -->
		<body name="object0" pos="1.3 0.6 0.45">
			<joint name="object0:joint" type="free" damping="0.01"></joint>
			<!-- Square cross-section peg (half-sizes: 1cm × 1cm × 4cm) -->
			<geom name="object0" type="box" size="0.01 0.01 0.04" mass="0.3" rgba="0.2 0.6 0.85 1" condim="4" friction="1 0.5 0.5" margin="0.00001" solimp="0.99 0.99 0.01" solref="0.01 1"></geom>
			<site name="object0" pos="0 0 0" size="0.01 0.01 0.04" rgba="0.2 0.6 0.85 0.3" type="box"></site>
		</body>

		<!-- Hole Plate - fixed on table rear -->
		<!-- Plate: 30cm × 30cm × 2cm, Hole: 2.02cm × 2.02cm (0.1mm clearance per side) -->
		<body name="hole_plate" pos="1.3 0.95 0.42">
			<!-- Base plate (bottom) - 30cm × 30cm × 1cm -->
			<geom name="plate_base" type="box" size="0.15 0.15 0.005" pos="0 0 -0.015" rgba="0.5 0.5 0.4 1" mass="1000" condim="4" friction="1 0.5 0.5"></geom>

			<!-- Four walls creating 2.2cm × 2.2cm hole in center -->
			<!-- Wall thickness: 1cm (half-size: 0.005m) -->
			<!-- Hole half-size: 0.0101m (0.1mm clearance), Wall position: 0.0101 + 0.005 = 0.0151m -->

			<!-- Front wall (positive Y side) -->
			<geom name="plate_wall_front" type="box" size="0.15 0.005 0.025" pos="0 0.0151 0.01" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001"></geom>

			<!-- Back wall (negative Y side) -->
			<geom name="plate_wall_back" type="box" size="0.15 0.005 0.025" pos="0 -0.0151 0.01" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001"></geom>

			<!-- Left wall (negative X side) -->
			<geom name="plate_wall_left" type="box" size="0.005 0.0101 0.025" pos="-0.0151 0 0.01" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001"></geom>

			<!-- Right wall (positive X side) -->
			<geom name="plate_wall_right" type="box" size="0.005 0.0101 0.025" pos="0.0151 0 0.01" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001"></geom>

			<!-- Visual site for hole center (target visualization) -->
			<site name="hole_center" pos="0 0 0.01" size="0.005 0.005 0.005" rgba="1 0 0 0.5" type="sphere"></site>
		</body>

		<light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="false" pos="0 0 4" dir="0 0 -1" name="light0"></light>
	</worldbody>

	<actuator>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="30000" name="robot0:l_gripper_finger_joint" user="1"></position>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="30000" name="robot0:r_gripper_finger_joint" user="1"></position>
	</actuator>
</mujoco>
