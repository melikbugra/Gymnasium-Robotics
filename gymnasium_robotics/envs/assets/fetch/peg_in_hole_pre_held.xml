<?xml version="1.0" encoding="utf-8"?>
<mujoco>
	<compiler angle="radian" coordinate="local" meshdir="../stls/fetch" texturedir="../textures"></compiler>
	<option timestep="0.002">
		<flag warmstart="enable"></flag>
	</option>

	<include file="shared.xml"></include>

	<worldbody>
		<geom name="floor0" pos="0.8 0.75 0" size="0.85 0.7 1" type="plane" condim="3" material="floor_mat"></geom>
		<body name="floor0" pos="0.8 0.75 0">
			<!-- Target marker hidden for pre-held version (goal is at hole center) -->
			<site name="target0" pos="0 0 0.5" size="0.02 0.02 0.02" rgba="1 0 0 0" type="sphere"></site>
		</body>

		<include file="robot.xml"></include>

		<body pos="1.425 0.75 0.2" name="table0">
			<geom size="0.325 0.35 0.2" type="box" mass="2000" material="table_mat"></geom>
		</body>

		<!-- Square Peg object - 2cm × 2cm × 8cm -->
		<!-- Pre-held: starts in gripper's position, held by closed gripper -->
		<!-- Mass reduced to 0.05kg for easier gripping -->
		<body name="object0" pos="1.3419 0.7491 0.515">
			<joint name="object0:joint" type="free" damping="0.01"></joint>
			<!-- Square cross-section peg (half-sizes: 1cm × 1cm × 4cm) -->
			<!-- Very high friction for secure gripper hold -->
			<!-- Hard contact: solimp with high dmin/dmax prevents penetration -->
			<geom name="object0" type="box" size="0.01 0.01 0.04" mass="0.05" rgba="0.2 0.6 0.85 1" condim="4" friction="10.0 8.0 8.0" margin="0.00001" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>
			<site name="object0" pos="0 0 0" size="0.01 0.01 0.04" rgba="0.2 0.6 0.85 0.3" type="box"></site>
		</body>

		<!-- Hole Plate - positioned at X=1.475 Y=0.825 for low arm tilt (~2°) -->
		<!-- Plate: 30cm × 30cm × 2cm, Hole: 2.02cm × 2.02cm (0.1mm clearance per side) -->
		<body name="hole_plate" pos="1.525 0.825 0.42">
			<!-- Base plate (bottom) - 30cm × 30cm × 1cm -->
			<geom name="plate_base" type="box" size="0.15 0.15 0.005" pos="0 0 -0.015" rgba="0.5 0.5 0.4 1" mass="1000" condim="4" friction="1 0.5 0.5" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>

			<!-- Four walls creating 2.02cm × 2.02cm hole in center -->
			<!-- Wall thickness: 10cm (half-size: 0.05m) -->
			<!-- Hole half-size: 0.0101m (0.1mm clearance per side for 2cm peg) -->
			<!-- Max tilt: arcsin(0.0001/0.04) = 0.14° -->
			<!-- Wall position: 0.0101 + 0.05 = 0.0601m -->

			<!-- Front wall (positive Y side) -->
			<geom name="plate_wall_front" type="box" size="0.15 0.05 0.05" pos="0 0.0601 0.035" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>

			<!-- Back wall (negative Y side) -->
			<geom name="plate_wall_back" type="box" size="0.15 0.05 0.05" pos="0 -0.0601 0.035" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>

			<!-- Left wall (negative X side) -->
			<geom name="plate_wall_left" type="box" size="0.05 0.0101 0.05" pos="-0.0601 0 0.035" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>

			<!-- Right wall (positive X side) -->
			<geom name="plate_wall_right" type="box" size="0.05 0.0101 0.05" pos="0.0601 0 0.035" rgba="0.5 0.5 0.4 1" condim="4" friction="1 0.5 0.5" margin="0.00001" solimp="0.99 0.999 0.0001" solref="0.002 1"></geom>

			<!-- Visual site for hole center (target visualization) -->
			<site name="hole_center" pos="0 0 0.035" size="0.005 0.005 0.005" rgba="1 0 0 0.5" type="sphere"></site>
		</body>

		<!-- Fixed overhead ceiling barriers (thin elongated panels above entire robot body) -->
		<!-- Right panel (positive Y side): 90cm × 20cm × 2cm, floating at Z=1.15 -->
		<body name="obstacle_right" pos="1.1 1.0 1.15">
			<geom name="obstacle_right" type="box" size="0.45 0.10 0.01"
				  rgba="0.9 0.2 0.2 0.7" mass="1000" condim="4" friction="0.5 0.5 0.5"
				  solimp="0.99 0.999 0.0001" solref="0.002 1"/>
		</body>
		<!-- Left panel (negative Y side): 90cm × 20cm × 2cm, floating at Z=1.15 -->
		<body name="obstacle_left" pos="1.1 0.55 1.15">
			<geom name="obstacle_left" type="box" size="0.45 0.10 0.01"
				  rgba="0.9 0.2 0.2 0.7" mass="1000" condim="4" friction="0.5 0.5 0.5"
				  solimp="0.99 0.999 0.0001" solref="0.002 1"/>
		</body>
		<!-- Front vertical wall (positive Y table edge): 20cm × 2cm × 90cm, standing -->
		<body name="obstacle_front" pos="1.225 1.10 0.70">
			<geom name="obstacle_front" type="box" size="0.10 0.01 0.45"
				  rgba="0.9 0.2 0.2 0.7" mass="1000" condim="4" friction="0.5 0.5 0.5"
				  solimp="0.99 0.999 0.0001" solref="0.002 1"/>
		</body>
		<!-- Back vertical wall (negative Y table edge): 20cm × 2cm × 90cm, standing -->
		<body name="obstacle_back" pos="1.225 0.40 0.70">
			<geom name="obstacle_back" type="box" size="0.10 0.01 0.45"
				  rgba="0.9 0.2 0.2 0.7" mass="1000" condim="4" friction="0.5 0.5 0.5"
				  solimp="0.99 0.999 0.0001" solref="0.002 1"/>
		</body>

		<light directional="true" ambient="0.2 0.2 0.2" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" castshadow="false" pos="0 0 4" dir="0 0 -1" name="light0"></light>
	</worldbody>

	<!-- Contact pairs for hard collisions -->
	<contact>
		<!-- Peg vs gripper fingers - HIGH friction to prevent slipping -->
		<pair geom1="object0" geom2="robot0:r_gripper_finger_link" condim="4" friction="10 10 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="object0" geom2="robot0:l_gripper_finger_link" condim="4" friction="10 10 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<!-- Peg vs gripper body - prevents peg from going into gripper -->
		<pair geom1="object0" geom2="robot0:gripper_link" condim="4" friction="5 5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<!-- Peg vs wrist - extra safety -->
		<pair geom1="object0" geom2="robot0:wrist_roll_link" condim="4" friction="2 2 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="object0" geom2="robot0:wrist_flex_link" condim="4" friction="2 2 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<!-- Peg vs hole walls - VERY hard contact to prevent penetration -->
		<pair geom1="object0" geom2="plate_wall_front" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.001 1" solimp="0.999 0.9999 0.00001" margin="0.00001"></pair>
		<pair geom1="object0" geom2="plate_wall_back" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.001 1" solimp="0.999 0.9999 0.00001" margin="0.00001"></pair>
		<pair geom1="object0" geom2="plate_wall_left" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.001 1" solimp="0.999 0.9999 0.00001" margin="0.00001"></pair>
		<pair geom1="object0" geom2="plate_wall_right" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.001 1" solimp="0.999 0.9999 0.00001" margin="0.00001"></pair>
		<pair geom1="object0" geom2="plate_base" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.001 1" solimp="0.999 0.9999 0.00001" margin="0.00001"></pair>

		<!-- Obstacle_right vs robot arm links -->
		<pair geom1="obstacle_right" geom2="robot0:elbow_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:forearm_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:wrist_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:wrist_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:gripper_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:r_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="robot0:l_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_right" geom2="object0" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>

		<!-- Obstacle_left vs robot arm links -->
		<pair geom1="obstacle_left" geom2="robot0:elbow_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:forearm_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:wrist_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:wrist_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:gripper_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:r_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="robot0:l_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_left" geom2="object0" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>

		<!-- Obstacle_front vs robot arm links -->
		<pair geom1="obstacle_front" geom2="robot0:elbow_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:forearm_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:wrist_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:wrist_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:gripper_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:r_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="robot0:l_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_front" geom2="object0" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>

		<!-- Obstacle_back vs robot arm links -->
		<pair geom1="obstacle_back" geom2="robot0:elbow_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:forearm_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:wrist_flex_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:wrist_roll_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:gripper_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:r_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="robot0:l_gripper_finger_link" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>
		<pair geom1="obstacle_back" geom2="object0" condim="4" friction="0.5 0.5 0.005 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.999 0.0001"></pair>

		<!-- Note: obstacle-vs-obstacle and obstacle-vs-hole_plate contacts omitted
		     because both are static bodies (MuJoCo disallows static-static contacts) -->
	</contact>

	<equality>
		<!-- Weld peg to gripper: prevents peg from flying out during insertion.
		     Wall contacts still computed normally - agent must rotate to align.
		     relpose set programmatically in _reset_sim after positioning. -->
		<weld name="peg_grip" body1="robot0:gripper_link" body2="object0" solref="0.0005 1" solimp="0.999 0.9999 0.00001 0.5 2"/>
	</equality>

	<actuator>
		<!-- Gripper actuators: fingers still close for realistic contact forces -->
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:l_gripper_finger_joint" kp="200000" name="robot0:l_gripper_finger_joint" user="1"></position>
		<position ctrllimited="true" ctrlrange="0 0.2" joint="robot0:r_gripper_finger_joint" kp="200000" name="robot0:r_gripper_finger_joint" user="1"></position>
	</actuator>
</mujoco>
